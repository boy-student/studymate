rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function follows(fromUid, toUid) {
      return signedIn() && exists(/databases/$(database)/documents/follows/$(fromUid + "_" + toUid));
    }
    function mutual(uid) { return follows(request.auth.uid, uid) && follows(uid, request.auth.uid); }
    function canView(uid) {
      return signedIn() && (request.auth.uid == uid
        || (exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.isPrivate == false)
        || mutual(uid));
    }
    match /profileDirectory/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "isPrivate", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.isPrivate is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if canView(uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "bio", "isPrivate", "createdAt", "updatedAt", "username"])
        && request.resource.data.displayName is string;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "bio", "isPrivate", "createdAt", "updatedAt", "username"])
        && request.resource.data.displayName is string
        && request.resource.data.isPrivate is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
      match /studyRecords/{recordId} {
        allow read: if canView(uid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["subject", "minutes", "comment", "createdAt"])
          && request.resource.data.subject is string
          && request.resource.data.minutes is int
          && request.resource.data.minutes > 0 && request.resource.data.minutes <= 1440;
        allow update, delete: if signedIn() && request.auth.uid == uid;
      }
      match /weeklyGoals/{weekId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["goalMinutes", "weekStart", "createdAt"])
          && request.resource.data.goalMinutes is int && request.resource.data.goalMinutes >= 0
          && request.resource.data.goalMinutes <= 10080 && request.resource.data.weekStart is string;
        allow update, delete: if false;
      }
      match /tasks/{taskId} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }
    match /follows/{followId} {
      // Read access supports follower/following counts and follow-state checks for signed-in members.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["followerUid", "targetUid", "createdAt"])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && followId == request.auth.uid + "_" + request.resource.data.targetUid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }
    // Legacy friendship collection is intentionally disabled; the app now uses one-way follows.
    match /friendships/{id} { allow read, write: if false; }
  }
}